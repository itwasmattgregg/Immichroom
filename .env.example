# Immich server origin (no trailing slash). Works with Tailscale MagicDNS.
EXPO_PUBLIC_IMMICH_BASE_URL=https://immich.example.ts.net

# Recommended: Immich API key (Account → API Keys). Sent as x-api-key.
EXPO_PUBLIC_IMMICH_API_KEY=

# Optional later: email/password login via ImmichClient.login() instead of API key.
